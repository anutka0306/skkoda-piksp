<section class="ourProduction__block" id="works">
    <div class="container">
        <p class="title">Более 280 <strong>видов работ</strong></p>
        <p class="cycle_text">Оказываем полный спектр услуг по ремонту и обслуживанию SKODA</p>
        <div class="present">
            <blockquote>
                <ul>
                    <li><strong>Скидка 10%</strong> на любые работы при первом посещении нашего СТО</li>
                    <li><strong>Бесплатная диагностика</strong> и осмотр вашего авто по 45 параметрам по предварительной записи</li>
                    <li><strong>Гарантия на все работы</strong> до 2-х лет</li>
                </ul>
                <span>в подарок</span>
            </blockquote>
        </div>
        {# Блок «Марка автомобиля: SKODA» убран по замечанию заказчика 15.08.2026:
           переключатель марок не нужен, сайт только по Skoda. #}

        <!--Содержимое табов-->
        <div id="tab3" class="tab__content active">
            <div class="category__list">
                {# Детейлинг скрыт по замечанию заказчика 15.08.2026 — такой услуги нет.
                   Фильтруем до цикла, иначе собьётся нумерация карточек (loop.index). #}
                {% for category in categories|filter(c => c.slug != 'deteyling') %}
                    <div class="about_item">
                    <a href="/{{ category.slug }}" title="{{ category.name }} SKODA">
                        <div class="about_item-img">{{ '%02d'|format(loop.index) }}</div>
                        <div class="about_item-img-2">SKODA</div>
                        {# Марка в названии карточки — просьба Татьяны 20.08.2026 #}
                        <div class="about_item-title">{{ category.name }} Шкода
                            {{ include('components/icons/service_list_bg.html.twig') }}
                        </div>
                    </a>
                </div>
                {% endfor %}
            </div>
        </div>
        <!--Содержимое табов-->

        {{ include('v3/blocks/section/warranty.html.twig') }}

    </div>
</section>