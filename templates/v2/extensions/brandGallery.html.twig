<section class="brand__gallery_slider_wrapper">
    <div class="brand__gallery_slider">
        {% for file in files %}
            <div class="brand__gallery_slider_item">
                <a class="brand__gallery_slider_item_link image-link" href="{{ file }}">
                    <img src="{{ file }}" width="320" height="180">
                </a>
            </div>
        {% endfor %}
    </div>
</section>

