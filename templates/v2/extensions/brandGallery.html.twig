{#% if (path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) starts with '/porsche/') %}
{% elseif (path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) starts with '/skoda/') %}
    {% set imgs = ({'0':'1.jpg','1':'2.jpg','2':'3.jpg','3':'4.jpg'}) %}
    {% set imgs = imgs|merge({'0':'5.jpg'}) %}
