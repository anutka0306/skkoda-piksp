{% extends 'v2/base.html.twig' %}


{% block description %}{{ page.metaDescription }}{% endblock %}

{% block header_line %}
    {{ include('v3/blocks/include/header.html.twig', {brands : brands ?? null, 'topMenu': topMenu, 'leftMenu': leftMenu}) }}
{% endblock %}

{% block header_banner %}
    {{ include('v3/blocks/section/hero.html.twig',{ h1 : block('h1') ?? page.h1 }) }}
{% endblock %}

{% block breadcrumbs %}
    <section id="breadcrumbs" style="margin-top: 100px;">
        <div class="container">
            <span class="navigation_item">
                <a href="/">Главная</a>
                <span>&#8646;</span>
            </span>
            <span class="navigation_item">
                <span>{{ page.h1 }}</span>
            </span>
        </div>
    </section>
{% endblock %}

{% block body %}
    <div class="container nashiraboty">

        <div class="nashiraboty__grid">

            {% for work in pagination %}

                <article class="nashiraboty__card">

                    <a class="nashiraboty__image" href="/blog/{{ work.alias }}/">

                        {% if work.blogImg %}
                            <img src="/img/nashiraboty_small/{{ work.blogImg }}"
                                 alt="{{ work.name }}">
                        {% endif %}

                    </a>

                    <div class="nashiraboty__content">

                        <a class="nashiraboty__title"
                           href="/blog/{{ work.alias }}/">

                            {{ work.name }}

                        </a>

                        <a class="nashiraboty__more"
                           href="/blog/{{ work.alias }}/">

                            Подробнее

                            <svg width="20" height="20">
                                <!-- стрелка -->
                            </svg>

                        </a>

                    </div>

                </article>

            {% endfor %}

        </div>

        <div class="navigation">
            {{ knp_pagination_render(pagination) }}
        </div>

    </div>

{% endblock %}