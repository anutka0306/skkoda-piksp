{% extends 'v2/base.html.twig' %}
{% block description %}{{ page.metaDescription }}{% endblock %}
{% block canonical %}{{ app.request.schemeAndHttpHost~'/blog/'~page.id~'/' }}{% endblock %}


{% block header_line %}
    {{ include('v3/blocks/include/header.html.twig', {brands : brands ?? null, 'topMenu': topMenu, 'leftMenu': leftMenu}) }}
{% endblock %}

{% block header_banner %}
    {{ include('v3/blocks/section/hero.html.twig',{ h1 : block('h1') ?? page.h1 }) }}
{% endblock %}

{% block breadcrumbs %}
    <section id="breadcrumbs" style="margin-top: 100px;">
        <div class="container">
                <span class="navigation_item">
                    <a href="/">Главная</a>
                    <span>&#8646;</span>
                </span>
            <span class="navigation_item">
                    <a href="/blog">Наши работы</a>
                    <span>&#8646;</span>
                </span>

            <span class="navigation_item">
                <span>{{ page.h1 }}</span>
                </span>


        </div>
    </section>
{% endblock %}

{% block body %}

    <div class="container work-page">

        <div class="page-header">
            <span class="work-title">{{ page.name }}</span>
        </div>

        {% if page.blogImg %}
            <div class="work-cover">
                <img src="/img/nashiraboty_small/{{ page.blogImg }}"
                     alt="{{ page.name }}">
            </div>
        {% endif %}

        <div class="work-content">
            {{ page.text|raw }}
        </div>

        {% if page.gallery %}
            <section class="work-gallery">

                <h2>Фотографии ремонта</h2>

                <div class="work-gallery__grid">

                    {% for image in page.gallery %}

                        <a
                                href="/images/ourworks/{{ image }}"
                                data-fancybox="work-gallery"
                                data-caption="{{ page.name }}"
                        >

                            <img src="/images/ourworks/{{ image }}">

                        </a>

                    {% endfor %}

                </div>

            </section>

        {% endif %}


        <section class="work-feedback">

            <div class="work-feedback__inner">

                <div>

                    <h2>Появилась похожая проблема?</h2>

                    <p>
                        Оставьте заявку — специалисты помогут определить неисправность и предложат оптимальное решение.
                    </p>

                </div>

                <a href="#popup_order" class="btn popup_btn">
                    Получить консультацию
                </a>

            </div>

        </section>

    </div>

{% endblock %}
{% block extraModules %}
    {{ our_works_slider(page) }}
{% endblock %}
