{# Простые информационные страницы (политика, cookies и т.п.) — дизайн v3, только текст #}
{% extends 'v2/base.html.twig' %}
{% block description %}{{ page.metaDescription }}{% endblock %}

{% block header_line %}
    {{ include('v3/blocks/include/header.html.twig', {brands : brands ?? null, 'topMenu': topMenu, 'leftMenu': leftMenu}) }}
{% endblock %}

{% block header_banner %}
    {{ include('v3/blocks/section/hero.html.twig',{ customH1 : page.h1 }) }}
{% endblock %}

{% block breadcrumbs %}
    <section id="breadcrumbs" style="margin-top: 100px;">
        <div class="container">
            <span class="navigation_item">
                <a href="/">Главная</a>
                <span>&#8646;</span>
            </span>
            <span class="navigation_item">
                <span>{{ page.h1 }}</span>
            </span>
        </div>
    </section>
{% endblock %}

{% block body %}
    <div class="container work-page">
        <div class="work-content">
            {{ page.text|raw }}
        </div>
    </div>
{% endblock %}
