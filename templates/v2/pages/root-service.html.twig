{% extends 'v2/base.html.twig' %}

{% block title %}
     {{ page.name~' Skoda — честная цена и гарантия | Сервис Шкода в Санкт-Петербурге' }}
{% endblock %}

{% block description %}
   {{page.name~' Skoda. Профессиональный ремонт и обслуживание Skoda в Санкт-Петербурге✅ Подбор запчастей под модель. Смета до начала работ. ✅ Звоните!'}}
{% endblock %}

{% block header_line %}
    {{ include('v3/blocks/include/header.html.twig', {brands : brands ?? null, 'topMenu': topMenu, 'leftMenu': leftMenu}) }}
{% endblock %}

{% block header_banner %}
    {{ include('v3/blocks/section/hero.html.twig',{ h1 : block('h1') ?? page.h1 }) }}
{% endblock %}

{% block body %}
    {% set is_category = page.path|trim('/')|split('/')|length == 1 %}
    {% set price_html = is_category ? price_list(page) : '' %}

    {# Шаблонный SEO-текст, пункт 5б — выводится только если своего текста нет #}
    {{ include('v3/blocks/section/seo_lead.html.twig',
        {'lead_type': is_category ? 'category' : 'service'}) }}

    {{ include('elements/_content.html.twig') }}

    {# Прайс-лист поднят сразу под текст категории — замечание заказчика 15.08.2026 (п. 9):
       раньше список услуг стоял в самом низу, после акций, гарантий и формы.
       На конечной услуге список не выводится: он размывает плотность ключей (п. 6). #}
    {% if is_category %}
        {{ price_html|raw }}
    {% endif %}

    {{ include('v3/blocks/section/promo.html.twig') }}

    {# Форма опущена под акции — просьба Татьяны 19.08.2026 #}
    {{ include('v3/blocks/section/steps.html.twig') }}
    {# отзывы скрыты до проработки — 29.07.2026 #}{# include('v3/blocks/section/opinions.html.twig') #}
    {{ include('v3/blocks/section/benefits.html.twig') }}
    {{ include('v3/blocks/section/gallery.html.twig') }}
    <section class="ourProduction__block" id="works">
        <div class="container">
            {{ include('v3/blocks/section/warranty.html.twig') }}
        </div>
    </section>
    {{ include('v3/blocks/section/questions.html.twig') }}



{% endblock %}
