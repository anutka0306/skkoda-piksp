
{% extends 'v2/base.html.twig' %}
{% block title %} {{ page.priceBrand.name~' в Санкт-Петербурге. Автосервис '~  page.priceBrand.name|upper~' ПИК' }} {% endblock %}
{% block description %} {% if phone is defined %}{{'Ремонт '~ page.priceBrand.name~' в Санкт-Петербурге.✔ Ежедневно 9:00 - 21:00 ✔ *Название страницы* (марка модель на руском) в день обращения ✔ Стоимость и цены. ✔ Гарантия 1 год! Профильный автосервис '~page.priceBrand.name|upper~ ' «ПИК» - ☎ '~phone.value }} {% else%} {{'Ремонт '~ page.priceBrand.name~' в Санкт-Петербурге.✔ Ежедневно 9:00 - 21:00 ✔ *Название страницы* (марка модель на руском) в день обращения ✔ Стоимость и цены. ✔ Гарантия 1 год! Профильный автосервис '~page.priceBrand.name|upper~ ' «ПИК» - ☎ '}}{% endif %}{% endblock %}

{% block header_line %}
    {{ include('v2/blocks/include/header_models.html.twig', {models : models ?? null, brandPath, brandName : page.priceBrand.name, logo : page.priceBrand.imgLogo, 'topMenu': topMenu, 'leftMenu': leftMenu}) }}
{% endblock %}
{% block header_banner %}
    {{ include('v2/blocks/section/hero.html.twig',{ h1 : block('h1') ?? page.h1, photoBig : page.priceBrand.photoBig, brandName : page.priceBrand.name }) }}
{% endblock %}

{% block body %}
    {{ include('elements/_content.html.twig') }}
    {{ price_list(page) }}
    {{ brand_models_service(page.priceBrand, page.priceBrand.path) }}
    {{ service_list(page) }}
    {{ include('elements/_advantages.html.twig',{brandName: page.priceBrand.name}) }}
    {{ include('elements/_advantages2.html.twig', {brandName: page.priceBrand.name}) }}
    {{ special_offers(page.brandAndModelName) }}
    {{ include('elements/_about_company.html.twig', {brandName: page.priceBrand.name}) }}

    {% if pageWork is not empty %}
        {% if pageWork is iterable %}
            {{ include('elements/examples.html.twig', {'pageWork' : pageWork[0]}) }}
        {% else %}
            {{ include('elements/examples.html.twig', {'pageWork' : pageWork}) }}
        {% endif %}
    {% endif %}

    {{ include('elements/_quote.html.twig') }}
    {{ include('elements/_team.html.twig', {brandName: page.priceBrand.name}) }}
{% endblock %}
