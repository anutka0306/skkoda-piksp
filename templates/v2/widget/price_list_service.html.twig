<section class="ourProduction__block" id="works">
    <div class="container">
        <!--Содержимое табов-->
        <div id="tab3" class="tab__content active">
            <div class="category__list">
                {% for section in sections %}
                    {% if section.priceServices is not empty %}
                        {% for service in section.priceServices|filter(service => service.published ) %}
                            {% if service.path  and service.published %}
                                <div class="about_item">
                                    <a href="{{ service.path }}" title="{{ service.name }} SKODA">
                                        <div class="about_item-img">{{ '%02d'|format(loop.index) }}</div>
                                        <div class="about_item-img-2">SKODA</div>
                                        <div class="about_item-title">{{ service.name }}
                                            {{ include('components/icons/service_list_bg.html.twig') }}
                                        </div>
                                    </a>
                                </div>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                {% endfor %}
            </div>
        </div>
        <!--Содержимое табов-->
    </div>
</section>
