<a id="footer_contacts"></a>
<section id="contacts" class="contacts-section" {% if phone is defined and phone2 is defined and phone3 is defined and address is defined and address2 is defined and address3 is defined %} style="height: 710px;" {% endif %}>
    <div class="contacts__inner">
        <div class="container">
            <div class="row">
                <div class="col-lg-5 col-12">
                    <div class="contacts">
                        <h2 class="contacts__heading">Контакты</h2>
                        <ul class="contacts">
                            {% if (phone is defined and phone is not null) and (address is defined and address is not null) %}
                            <li class="contacts__item">
                                <div class="contacts__icon">
                                    <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                                </div>
                                <div class="contacts__info">
                                    <h6 class="contact__heading">{% if contactTitle is defined %}{{ contactTitle }} {% else %} {{ address.title }}{% endif %}</h6>

                                        <p style="line-height: .5">{{ address.value }}</p>
                                        <p style="line-height: .5"> <span class="phone-number"><a href="tel:{{ phone.value }}">{{ phone.title }}</a></span></p>
                                </div>
                            </li>
                            {% endif %}

                            {% if (phone2 is defined and phone2 is not null) and (address2 is defined and address2 is not null) %}
                            <li class="contacts__item">
                                <div class="contacts__icon">
                                    <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                                </div>
                                <div class="contacts__info">
                                    <h6 class="contact__heading">Land Rover / Jaguar</h6>
                                        <p style="line-height: .5">{{ address2.value }}</p>
                                        <p style="line-height: .5"> <span class="phone-number"><a href="tel:{{ phone2.value }}">{{ phone2.title }}</a></span></p>
                                </div>
                            </li>
                            {% endif %}

                            {% if (phone3 is defined and phone3 is not null) and (address3 is defined and address3 is not null) %}
                            <li class="contacts__item">
                                <div class="contacts__icon">
                                    <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                                </div>
                                <div class="contacts__info">
                                    <h6 class="contact__heading">Porsche</h6>
                                        <p style="line-height: .5">{{ address3.value }}</p>
                                        <p style="line-height: .5"> <span class="phone-number"><a href="tel:{{ phone3.value }}">{{ phone3.title }}</a></span></p>
                                </div>
                            </li>
                            {% endif %}
                            <li class="contacts__item">
                                <div class="contacts__icon">
                                    <i class="fas fa-envelope" aria-hidden="true"></i>
                                </div>
                                <div class="contacts__info">
                                    <h6 class="contact__heading">E-mail</h6>
                                    <a href="mailto:info@piksp.ru">info@piksp.ru</a>
                                </div>
                            </li>
                            <li class="contacts__item">
                                <div class="contacts__icon">
                                    <i class="far fa-calendar-alt" aria-hidden="true"></i>
                                </div>
                                <div class="contacts__info">
                                    <h6 class="contact__heading">Режим работы</h6>
                                    <p>Ежедневно <br>
                                        с 09:00 до 21:00</p>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>

            </div>
        </div>


        {% if (phone is defined and phone is not null) and (address is defined and address is not null) and (phone2 is defined and phone2 is not null) and (address2 is defined and address2 is not null) %}
            {% if phone is defined and phone2 is defined and phone3 is defined and address is defined and address2 is defined and address3 is defined %}
                <div id="picsp_map" class="contacts__map">
                    <script type="text/javascript" charset="utf-8" async src="https://api-maps.yandex.ru/services/constructor/1.0/js/?um=constructor%3A3fc6af8d1a63b00664dd65611e1e20063ad1a1af4d71f3c8f21d03a8d36953e9&amp;width=100%25&amp;height=680&amp;lang=ru_RU&amp;scroll=true"></script>
                </div>
            {% else %}
                <div id="picsp_map" class="contacts__map">
                    <script type="text/javascript" charset="utf-8" async src="https://api-maps.yandex.ru/services/constructor/1.0/js/?um=constructor%3A3fc6af8d1a63b00664dd65611e1e20063ad1a1af4d71f3c8f21d03a8d36953e9&amp;width=100%25&amp;height=577&amp;lang=ru_RU&amp;scroll=true"></script>
                </div>
                {% endif %}
        {% elseif map is defined and map is not null %}
            <div id="picsp_map" class="contacts__map">
                {{ map|raw }}
            </div>
        {% else %}
            <div id="picsp_map" class="contacts__map">
                <script type="text/javascript" charset="utf-8" async src="https://api-maps.yandex.ru/services/constructor/1.0/js/?um=constructor%3A8b5f437fbde1ed0224ea38576af81791b2fb3229105e9289d29a24bae02dad6c&amp;width=100%25&amp;height=577&amp;lang=ru_RU&amp;scroll=true"></script>
            </div>
        {% endif %}

    </div>
</section>