            .cookie-message {
                position: fixed;
                width: 100%;
                z-index: 1000;
                bottom: 0;
                background-color: #fff;
                box-shadow: rgb(120 250 174) 0px 0px 10px;
            }

            .cookie-message-inner {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 1.5rem 0;
                line-height: 1.2;
            }

            .cookie-message-text {
                flex-grow: 2;
            }

            .button .js-cookie-message-confirm {

            }
            .cookie-message-text a {
                text-decoration: underline;
                color: #35b96c;
            }
            .cookie-message-text a:hover {
                text-decoration: underline;
                color: #0e3a30;
            }
        </style>

        <div class="cookie-message js-cookie-message" hidden>
            <div class="container">
                <div class="cookie-message-inner">
                    <div class="cookie-message-text">
                        Продолжая просмотр страниц сайта, вы соглашаетесь с использованием файлов куки (cookies).
                    </div>
                    <button class="btn js-cookie-message-confirm" style="border: none;">OK</button>
                </div>
            </div>
        </div>

        <script>
    if (!localStorage.getItem('cookieAccept')) {
        const el = document.querySelector('.js-cookie-message');
        el.style.display = 'block';
        el.querySelector('.js-cookie-message-confirm').addEventListener('click', (e) => {
            localStorage.setItem('cookieAccept', 1);
            el.style.display = 'none';
        }, true);
    }
</script>
