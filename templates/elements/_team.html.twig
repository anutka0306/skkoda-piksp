            механики и квалифицированные консультанты.</p>
    </div>
    <div class="team">
        <div class="container">
            <div class="row">
                <div class="col-lg-3 col-sm-6 col-12 team__member">
                    <div class="team__photo">
                        <img loading="lazy" src="{{ asset('img/team-1.png') }}" alt="">
                    </div>
                    <h5 class="team__name">
